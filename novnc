#!/bin/sh
### BEGIN INIT INFO
# Provides:          novnc
# Required-Start:    $network
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:
# Short-Description: Start noVNC proxy
### END INIT INFO

DAEMON="/root/noVNC/utils/novnc_proxy"
DAEMON_ARGS="--vnc localhost:5901 --listen 0.0.0.0:6080"
PIDFILE="/var/run/novnc.pid"

start() {
    echo "Starting noVNC..."
    start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" --exec "$DAEMON" -- $DAEMON_ARGS
}

stop() {
    echo "Stopping noVNC..."
    start-stop-daemon --stop --pidfile "$PIDFILE" --retry 5
}

status() {
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        if kill -0 "$PID" 2>/dev/null; then
            echo "noVNC is running (PID $PID)"
            return 0
        fi
    fi
    echo "noVNC is not running"
    return 1
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|status}" ;;
esac
